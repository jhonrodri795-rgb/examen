{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "../dist-server",
    "rootDir": "..",
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.server.build.tsbuildinfo",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "start.ts", "../shared"],
  "exclude": ["src/**/*.test.ts"]
}
