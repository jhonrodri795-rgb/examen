# ─────────────────────────────────────────────────────────────────────────────
# TOEFL Prep Studio — configuración del servidor local (opcional)
#
# Copia este archivo como `.env` y rellena solo lo que vayas a usar.
# Estas variables se leen ÚNICAMENTE en el proceso de Node (Vite dev / npm start);
# nunca se incluyen en el código del navegador. No uses el prefijo VITE_.
# Sin ninguna clave, la aplicación funciona completa con análisis local y rúbricas.
# ─────────────────────────────────────────────────────────────────────────────

# ── Transcripción automática (Speech-to-Text) ────────────────────────────────
# openai | deepgram | azure | none   (si se omite, se detecta por la clave presente)
# Con solo AZURE_SPEECH_KEY + AZURE_SPEECH_REGION se usa Azure para transcribir y
# puntuar pronunciación, fluidez y prosodia en la misma llamada (recomendado para
# practicar la forma de hablar).
STT_PROVIDER=

# OpenAI (o cualquier servidor compatible con /v1/audio/transcriptions,
# p. ej. un Whisper autoalojado: cambia OPENAI_BASE_URL).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# whisper-1 devuelve marcas de tiempo por palabra (recomendado para métricas de fluidez).
OPENAI_STT_MODEL=whisper-1

# Deepgram (confianza por palabra y detección de muletillas).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ── Azure AI Speech: transcripción + pronunciación, fluidez y prosodia ───────
# Listen and Repeat: evaluación con la frase de referencia. Interview: evaluación
# sin guion (respuesta libre, hasta 60 s). Audio WAV 16 kHz convertido en el navegador.
# Cómo obtener la clave: portal.azure.com → Crear un recurso → «Speech» (Voz) →
# elige región (p. ej. eastus o westeurope) y plan → «Claves y punto de conexión»:
# copia CLAVE 1 y la Ubicación/Región.
# azure | none
PRONUNCIATION_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Evaluador con IA (Speaking a partir de transcripción + métricas; Writing) ─
# anthropic | none   (si se omite y existe ANTHROPIC_API_KEY, se activa)
EVALUATOR_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# ── Límites y protección ─────────────────────────────────────────────────────
MAX_AUDIO_MB=10
MAX_AUDIO_SECONDS=120
MIN_AUDIO_SECONDS=0.8
MAX_TEXT_CHARS=8000
# Solicitudes a proveedores externos por cliente y ventana (minutos).
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MIN=10
PROVIDER_TIMEOUT_MS=60000

# ── Servidor de producción (npm start) ───────────────────────────────────────
PORT=8787
HOST=127.0.0.1
